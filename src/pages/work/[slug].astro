---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import Cover from '../../components/Cover.astro';
import Placeholder from '../../components/case/Placeholder.astro';
import { houseHref } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('work', (w) => w.data.published)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: all[i + 1] as CollectionEntry<'work'> | undefined },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
}
const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const sections = headings.filter((h) => h.depth === 2);
const words = (entry.body ?? '').replace(/<[^>]+>|\{[^}]*\}|import .*$/gm, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const number = String(d.order).padStart(2, '0');
---
<Base title={d.title} description={d.summary} bareHeader>
  <header slot="header" class="readbar">
    <div class="container readbar-inner">
      <a class="quiet back" href="/#studio">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></svg>
        All work
      </a>
      <div class="readbar-end">
        <span class="muted">{minutes} min read</span>
        <a class="quiet inside" href={`${houseHref}?room=studio`}><span class="dot" aria-hidden="true"></span>Open in the studio</a>
      </div>
    </div>
    <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
  </header>

  <article>
    <!-- Sleeve + liner notes -->
    <section class="container cs-hero">
      <div class="cs-hero-text">
        <span class="label">Case study {number} · {d.company}</span>
        <h1 class="h1 cs-title">{d.title}</h1>
      </div>
      <Cover variant={d.cover} label={`Studio ${number}`} class="cs-cover" />
    </section>

    {d.meta.length > 0 && (
      <div class="container">
        <dl class="meta">
          {d.meta.map((m) => (
            <div>
              <dt class="label muted">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <div class="container hero-media">
      {d.heroImage ? (
        <Image src={d.heroImage} alt={d.heroAlt ?? ''} widths={[800, 1280, 1920]} sizes="(max-width: 1280px) 100vw, 1184px" />
      ) : (
        <Placeholder note="[Hero image: final screens in context]" ratio="16 / 7" />
      )}
    </div>

    {(d.tldr || d.metrics.length > 0) && (
      <section class="container" aria-label="Summary">
        <div class="tldr">
          {d.tldr && (
            <div class="tldr-text">
              <span class="label tldr-label">In short</span>
              <p>{d.tldr}</p>
            </div>
          )}
          {d.metrics.length > 0 && (
            <ul class="metrics" role="list">
              {d.metrics.map((m) => (
                <li><span class="metric-value">{m.value}</span><span class="metric-label">{m.label}</span></li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    <div class="container cs-body">
      {sections.length > 0 && (
        <nav class="toc" aria-label="On this page">
          <span class="label muted">On this page</span>
          <ol role="list">
            {sections.map((s, i) => (
              <li><a class="quiet" href={`#${s.slug}`} data-toc={s.slug}><span class="toc-n">{String(i + 1).padStart(2, '0')}</span>{s.text}</a></li>
            ))}
          </ol>
        </nav>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <a class="next quiet" href={next ? `/work/${next.id}` : '/#lab'}>
    <div class="container next-inner">
      <div class="next-text">
        <span class="label">{next ? 'Next in the studio' : 'Back to the tour'}</span>
        <span class="next-title">{next ? next.data.title : 'Next door is the lab.'}</span>
      </div>
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
    </div>
  </a>
</Base>

<script>
  // Reading progress + "On this page" highlight. Both are enhancements; the page works without them.
  const bar = document.getElementById('progress-bar');
  const article = document.querySelector('article');
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!bar || !article) return;
    const r = article.getBoundingClientRect();
    const total = r.height - window.innerHeight;
    const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
    bar.style.transform = `scaleX(${p})`;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();

  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  const heads = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const setActive = () => {
    let current = heads[0];
    for (const h of heads) if (h.getBoundingClientRect().top < window.innerHeight * 0.35) current = h;
    links.forEach((a, id) => a.toggleAttribute('aria-current', id === current?.id));
  };
  addEventListener('scroll', () => requestAnimationFrame(setActive), { passive: true });
  setActive();
</script>

<style>
  /* ---------- Reading bar ---------- */
  .readbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--page) 94%, transparent);
    backdrop-filter: blur(8px);
  }
  .readbar-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    align-items: center;
    min-height: 68px;
    font-size: 15px;
  }
  .back, .inside { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 600; }
  .readbar-end { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--red); }
  .progress { height: 2px; background: var(--rule); }
  .progress span {
    display: block;
    height: 100%;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ---------- Hero ---------- */
  .cs-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    gap: 40px 64px;
    align-items: end;
    padding-top: clamp(48px, 7vw, 96px);
    padding-bottom: 56px;
  }
  .cs-hero-text { display: flex; flex-direction: column; gap: 28px; }
  .cs-title { max-width: 820px; }
  @media (max-width: 820px) {
    .cs-hero { grid-template-columns: minmax(0, 1fr); }
    .cs-hero :global(.cs-cover) { max-width: 280px; }
  }

  .meta {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 0 32px;
  }
  .meta > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 0 20px;
    border-top: 2px solid var(--ink);
  }
  .meta dd { margin: 0; font-weight: 600; font-size: 17px; }

  /* ---------- In short ---------- */
  .hero-media { margin-top: 40px; }
  .hero-media :global(img) { width: 100%; height: auto; }
  .tldr {
    margin-top: 24px;
    background: var(--ink);
    color: var(--page);
    padding: clamp(28px, 5vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
  }
  .tldr-text { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .tldr-label { color: var(--mustard); }
  .tldr-text p { font-size: clamp(22px, 1.4rem + 0.5vw, 28px); font-weight: 600; line-height: 1.3; letter-spacing: -0.015em; }
  .metrics {
    flex: 1 1 420px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(120px, 100%), 1fr));
    gap: 24px 28px;
    align-content: end;
  }
  .metrics li { display: flex; flex-direction: column; gap: 8px; padding-top: 16px; border-top: 1px solid var(--on-ink-rule); }
  .metric-value { font-size: clamp(40px, 5vw, 56px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; }
  .metric-label { font-size: 14px; line-height: 1.4; color: var(--on-ink-muted); }

  /* ---------- Body ---------- */
  .cs-body {
    display: grid;
    grid-template-columns: 220px minmax(0, 720px);
    justify-content: start;
    gap: 40px clamp(48px, 8vw, 120px);
    padding-top: var(--section-y);
    padding-bottom: var(--section-y-lg);
  }
  .toc {
    position: sticky;
    top: 104px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .toc ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .toc a {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    font-size: 15px;
    color: var(--muted);
  }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); font-weight: 600; }
  .toc-n { font-variant-numeric: tabular-nums; min-width: 1.6em; }
  .toc a[aria-current] .toc-n { color: var(--red); }
  @media (max-width: 960px) {
    .cs-body { grid-template-columns: minmax(0, 1fr); }
    .toc { display: none; }
  }

  .prose {
    counter-reset: section;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }
  .prose :global(h2) {
    counter-increment: section;
    margin-top: 72px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.3;
    padding-top: 20px;
    border-top: 2px solid var(--ink);
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h2::before) { content: counter(section, decimal-leading-zero) ' · '; }
  .prose :global(h3) {
    margin-top: -4px;
    font-size: clamp(28px, 1.4rem + 1.2vw, 38px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .prose :global(p) { font-size: 18px; line-height: 1.65; color: var(--ink-soft); }
  .prose :global(ul:not([role])), .prose :global(ol:not([role])) { margin: 0; padding-left: 1.2em; color: var(--ink-soft); }
  .prose :global(img) { width: 100%; height: auto; }
  .prose :global(blockquote) {
    margin: 8px 0;
    padding-left: 24px;
    border-left: 3px solid var(--red);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
  }

  /* ---------- Next ---------- */
  .next { display: block; background: var(--mustard); color: var(--ink); }
  .next:hover { color: var(--ink); }
  .next-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: clamp(40px, 6vw, 64px);
  }
  .next-text { display: flex; flex-direction: column; gap: 10px; }
  .next-title { font-size: clamp(28px, 1.4rem + 1.4vw, 40px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
  .next svg { transition: transform 0.2s ease; }
  .next:hover svg { transform: translateX(6px); }
</style>
