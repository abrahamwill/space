---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { site, lab, about, houseHref } from '../data/site';
import { getHouseContent, inlineJson } from '../data/houseContent';
import houseLit from '../assets/house/poster-lit.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.slice(0, 3);
const publishedCount = work.filter((w) => w.data.published).length;
const pad = (n: number) => String(n).padStart(2, '0');
const houseContent = inlineJson(await getHouseContent());
---
<Base>
  <script type="application/json" id="house-content" set:html={houseContent} />
  <!-- Hero: the house is the point. Nothing else competes. -->
  <div class="hero-wrap">
    <section id="top" class="container hero">
      <div class="hero-copy">
        <span class="role muted">{site.role}</span>
        <h1 class="h1">Welcome to my space.</h1>
        <p class="hero-text">
          I design practical tools for farmers and field teams, and prototype them in code. Have a look
          around the house, or take the short tour below.
        </p>
        <div class="actions">
          <a class="btn" href={houseHref}>Step inside</a>
          <a class="tour quiet" href="#studio">Take the short tour ↓</a>
        </div>
      </div>
      <a class="house" href={houseHref} aria-label="Step inside the house">
        <Picture
          src={houseLit}
          formats={['avif', 'webp']}
          widths={[720, 1080, 1440, 1800, 2336]}
          sizes="(max-width: 900px) 165vw, 1120px"
          alt="My house, cut into the page: a main room with a turntable and sofa, a small studio behind it, and a lab to the right"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="house-live" data-house-live aria-hidden="true"></div>
      </a>
    </section>
  </div>

  <!-- 01 · The studio -->
  <section id="studio" class="container studio">
    <div class="section-head">
      <div class="section-title">
        <span class="label">01 · The studio</span>
        <h2 class="h2">First stop is the studio, where the work lives. Here are three projects I'd put on first.</h2>
      </div>
      {publishedCount > 3 && <a class="shelf" href="/work">The whole shelf →</a>}
    </div>
    <div class="cards">
      {featured.map((w, i) => {
        const inner = (
          <>
            <Cover variant={w.data.cover} label={`Studio ${pad(i + 1)}`} />
            <div class="card-text">
              <span class="card-title">{w.data.summary}</span>
              <span class="card-meta muted">{w.data.company} · {w.data.role} · {w.data.year}</span>
            </div>
          </>
        );
        return w.data.published ? (
          <a class="card quiet" href={`/work/${w.id}`}>{inner}</a>
        ) : (
          <div class="card is-placeholder">{inner}</div>
        );
      })}
    </div>
  </section>

  <!-- 02 · The lab -->
  <section id="lab" class="lab">
    <div class="container split">
      <div class="split-title">
        <span class="label lab-label">02 · The lab</span>
        <h2 class="h2">Next door is the lab, full of things I'm still figuring out.</h2>
      </div>
      <ul class="lab-list" role="list">
        {lab.map((item) => (
          <li class="lab-item">
            <span class={`mark mark-${item.mark}`} aria-hidden="true"></span>
            <div class="lab-text">
              <h3 class="lab-title">{item.title}</h3>
              <p class="lab-body">{item.body}</p>
            </div>
            <span class="lab-status">{item.status}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 · The main room -->
  <section id="about" class="container split about">
    <div class="split-title">
      <span class="label">03 · The main room</span>
      <h2 class="h2">And this is where I live, off the clock.</h2>
    </div>
    <div class="about-body">
      <p class="lead">{about.body}</p>
      <ul class="rows facts" role="list">
        {about.facts.map((f) => (
          <li><span>{f.what}</span><span class="muted">{f.when}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  /**
   * The live house in the hero, and stepping inside without a page load.
   *
   * Auto-load only when it's cheap and wanted: after the page is idle AND the hero is on screen.
   * Never on Save-Data, slow connections, low-memory devices, reduced motion, or ?mode=focus;
   * there it waits for intent (hover/focus/touch).
   *
   * Any link to /house on this page enters the house in place: the hero's canvas zooms up into
   * the house view (src/house/enter.ts). Modified clicks and browsers without WebGL just navigate.
   */
  import type { HouseEngine } from '../house/engine';
  import type { HouseContent } from '../house/content';

  const host = document.querySelector<HTMLElement>('[data-house-live]');
  const link = host?.closest<HTMLElement>('.house');
  if (host && link) {
    type Conn = { saveData?: boolean; effectiveType?: string };
    const nav = navigator as Navigator & { connection?: Conn; deviceMemory?: number };
    const conn = nav.connection;
    const holdBack =
      conn?.saveData ||
      /(^|-)(2g|3g)$/.test(conn?.effectiveType ?? '') ||
      (nav.deviceMemory !== undefined && nav.deviceMemory <= 2) ||
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      document.documentElement.dataset.mode === 'focus';

    let engine: Promise<HouseEngine> | null = null;
    const start = () =>
      (engine ??= import('../house/hero').then(
        ({ mountHero }) =>
          new Promise<HouseEngine>((resolve) => {
            const e = mountHero(host, () => {
              link.classList.add('is-live');
              resolve(e);
            });
          }),
      ));
    // Dev only: this page has no React island, so @astrojs/react never adds the React Refresh
    // preamble, and importing enter.ts (React) throws "can't detect preamble". Install it first.
    const preamble: Promise<unknown> = import.meta.env.DEV
      ? import(/* @vite-ignore */ '/@react-refresh' as string).then(({ injectIntoGlobalHook }) => {
          const w = window as unknown as Record<string, unknown>;
          injectIntoGlobalHook(window);
          w.$RefreshReg$ = () => {};
          w.$RefreshSig$ = () => (type: unknown) => type;
        })
      : Promise.resolve();
    const loadEnter = () => preamble.then(() => import('../house/enter'));

    const warm = () => {
      start();
      loadEnter();
    };

    if (holdBack) {
      for (const ev of ['pointerenter', 'focusin', 'touchstart'] as const) link.addEventListener(ev, () => start(), { once: true, passive: true });
    } else {
      const idle = (cb: () => void) =>
        'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 4000 }) : setTimeout(cb, 1500);
      const whenLoaded = (cb: () => void) => (document.readyState === 'complete' ? cb() : addEventListener('load', cb, { once: true }));
      whenLoaded(() =>
        idle(() => {
          const io = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              start();
            }
          });
          io.observe(link);
        }),
      );
    }

    // ---- stepping inside ----
    const webgl = (() => {
      try {
        const c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch {
        return false;
      }
    })();
    const content = () => JSON.parse(document.getElementById('house-content')!.textContent!) as HouseContent;
    const isHouseLink = (t: EventTarget | null) => (t as Element | null)?.closest?.('a[href="/house"]');

    // Get the UI code moving as soon as someone looks like they'll go in.
    for (const ev of ['pointerover', 'focusin'] as const)
      document.addEventListener(ev, (e) => isHouseLink(e.target) && webgl && warm(), { passive: true });

    let busy = false;
    const go = async (push: boolean) => {
      if (busy) return;
      busy = true;
      document.documentElement.classList.add('house-loading');
      try {
        const [e, mod] = await Promise.all([start(), loadEnter()]);
        mod.onHistory(() => go(false));
        mod.enter(e, host, content(), push);
      } finally {
        busy = false;
        document.documentElement.classList.remove('house-loading');
      }
    };
    document.addEventListener('click', (e) => {
      if (!webgl || !isHouseLink(e.target)) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      go(true);
    });
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero-wrap { overflow-x: clip; }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
    align-items: center;
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: 40px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .role { font-size: 14px; }
  .hero-text { max-width: 380px; color: var(--ink-soft); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; padding-top: 8px; }
  .tour { font-weight: 600; font-size: 16px; }

  .house {
    display: block;
    width: 150%;
    margin-left: -8%;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .house:hover { transform: translateY(-6px); }
  .house { position: relative; }
  .house :global(img) { width: 100%; height: auto; transition: opacity 0.6s ease; }
  /* Live 3D house: sits exactly over the poster, fades in once it has drawn a frame. */
  .house-live { position: absolute; inset: 0; opacity: 0; transition: opacity 0.6s ease; }
  .house.is-live .house-live { opacity: 1; }
  .house.is-live :global(img) { opacity: 0; }
  /* while the canvas moves between the hero and the house, the poster holds the picture */
  .house.is-handoff :global(img) { opacity: 1; transition: none; }
  .house.is-away :global(img) { opacity: 0; transition: none; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .house { width: 165%; margin-left: -6%; margin-block: -8px -16px; }
  }

  /* ---------- Shared section heads ---------- */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    border-top: 2px solid var(--ink);
    padding-top: 24px;
  }
  .section-title { display: flex; flex-direction: column; gap: 14px; max-width: 760px; }
  .shelf { font-weight: 600; font-size: 15px; }

  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
  }
  .split-title { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .split > :last-child { flex: 1 1 560px; min-width: 0; }

  /* ---------- Studio ---------- */
  .studio {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding-top: var(--section-y);
    padding-bottom: var(--section-y-lg);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 56px 40px;
  }
  .card { display: flex; flex-direction: column; gap: 20px; color: var(--ink); }
  .card-text { display: flex; flex-direction: column; gap: 8px; }
  .card-title { font-weight: 600; font-size: 21px; line-height: 1.25; letter-spacing: -0.01em; }
  .card-meta { font-size: 14px; }
  .card :global(.cover) { transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1); }
  a.card:hover :global(.cover) { transform: translateY(-6px); }
  a.card:hover .card-title { color: var(--red); }

  /* ---------- Lab ---------- */
  .lab { background: var(--ink); color: var(--page); }
  .lab .split { padding-block: var(--section-y); }
  .lab-label { color: var(--mustard); }
  .lab-list { margin: 0; padding: 0; list-style: none; }
  .lab-item {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    gap: 8px 20px;
    align-items: baseline;
    padding: 26px 0;
    border-top: 1px solid var(--on-ink-rule);
  }
  .lab-item:last-child { border-bottom: 1px solid var(--on-ink-rule); }
  .lab-text { display: flex; flex-direction: column; gap: 6px; }
  .lab-title { font-weight: 600; font-size: 22px; line-height: 1.3; }
  .lab-body { font-size: 16px; line-height: 1.5; color: var(--on-ink-muted); }
  .lab-status { font-size: 13px; color: var(--on-ink-muted); white-space: nowrap; }
  .mark { display: block; width: 14px; height: 14px; }
  .mark-circle { border-radius: 50%; background: var(--red); }
  .mark-square { background: var(--cobalt); }
  .mark-triangle { width: 16px; background: var(--mustard); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  @media (max-width: 560px) {
    .lab-item { grid-template-columns: 28px minmax(0, 1fr); }
    .lab-status { grid-column: 2; }
  }

  /* ---------- About ---------- */
  .about { padding-block: var(--section-y-lg); }
  .about-body { display: flex; flex-direction: column; gap: 36px; }
  .facts { margin: 0; padding: 0; list-style: none; font-size: 15px; }
  .facts li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; }
</style>
