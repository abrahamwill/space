---
/**
 * Home, in the 2b "playful Mac" style (space-kit design/source/home-desktop.dc.html).
 * The hero keeps the live 3D house from milestones 2–4: poster first, 3D after load, step in place.
 */
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Space from '../layouts/Space.astro';
import PeekWin, { type WinData } from '../components/home/PeekWin.astro';
import NowPlaying from '../components/home/NowPlaying.astro';
import { site, lab, houseHref } from '../data/site';
// The Pinwheel house (House v2): a still of the live 3D (scripts/render-house3d-poster.mjs), so the
// 3D that fades in over it lines up exactly.
import housePoster from '../assets/house/hero-p2.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const [lead, ...rest] = work;
const metaLine = (w: (typeof work)[number]) => [w.data.company, w.data.year, w.data.role].join(' · ');

const wins: Record<'proto' | 'pet' | 'voice', WinData> = {
  proto: { kind: 'proto', file: 'Prototype Hub', title: 'Prototype Hub', desc: lab[0].body, href: '/work/prototype-hub', cta: 'Read the case study' },
  pet: { kind: 'pet', file: 'Pet game', title: 'A cozy pet game', desc: lab[1].body },
  voice: { kind: 'voice', file: 'Voice AI', title: 'Learning voice AI', desc: lab[2].body },
};
const labItems = [
  { win: wins.proto, line: lab[0].status },
  { win: wins.pet, line: 'Built on weekends. Not launched yet.' },
  { win: wins.voice, line: 'Conversational AI, bit by bit.' },
];
const tags = [
  ['Product', '#0a6cff'],
  ['Research', '#34c759'],
  ['Prototypes', '#ff9f0a'],
  ['Games', '#ff375f'],
  ['Voice AI', '#af52de'],
];
const info = [
  {
    id: 'general', title: 'General', rows: [
      ['Kind', 'Senior product designer'],
      ['At', 'Gokomodo, since 2021'],
      ['Studied', 'Computer Science, Universitas Indonesia'],
      ['Based in', site.basedIn],
    ],
  },
  {
    id: 'more', title: 'More info', rows: [
      ['Known for', "Leading research and design of GokoMart's farmer app, store portal and backoffice, for farmers in Kalimantan and Sumatra"],
      ['Building', 'Prototype Hub, and a cozy pet game'],
      ['Learning', 'Conversational and voice AI, bit by bit'],
    ],
  },
];
const mockRows = ['#ffd166', '#ff8fa3', '#7cc3fb', '#8ee09b', '#c9a7ff'];
---
<Space>

  <!-- ============ Menu bar ============ -->
  <header slot="header" class="mb">
    <nav class="mb-nav" aria-label="Main">
      <a class="mb-name" href="#top">Abraham</a>
      <a href="#work">Work</a>
      <a href="#lab">Lab</a>
      <a href="#about">About</a>
    </nav>
    <a class="mb-logo" href="#top" aria-label="Back to the top">
      <svg width="30" height="26" viewBox="0 0 30 26" aria-hidden="true"><path d="M3 12 L15 2 L27 12 V24 H3 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path><g class="mb-eyes"><rect x="10" y="13" width="3" height="5" rx="1.5" fill="currentColor"></rect><rect x="17" y="13" width="3" height="5" rx="1.5" fill="currentColor"></rect></g></svg>
      <span class="mb-logo-name">Abraham</span>
    </a>
    <div class="mb-end">
      <div class="np">
        <button type="button" class="np-btn" aria-label="Now playing" aria-expanded="false" aria-controls="np-pop" data-pop-btn>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 10 V8 a6 6 0 0 1 12 0 V10"></path><rect x="1.5" y="9.5" width="3" height="5" rx="1"></rect><rect x="11.5" y="9.5" width="3" height="5" rx="1"></rect></svg>
        </button>
        <div id="np-pop" class="np-pop" data-pop><NowPlaying playlist /></div>
      </div>
      <time class="mb-time" data-clock>--:--</time>
      <a class="mb-hi" href="#say-hi">Say hi</a>
      <button type="button" class="mb-menu" aria-label="Menu" aria-expanded="false" aria-controls="cc-menu" data-menu-btn>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><rect x="2" y="2" width="7" height="7" rx="2" fill="currentColor"></rect><rect x="11" y="2" width="7" height="7" rx="2" fill="currentColor" opacity=".55"></rect><rect x="2" y="11" width="7" height="7" rx="2" fill="currentColor" opacity=".55"></rect><rect x="11" y="11" width="7" height="7" rx="2" fill="currentColor"></rect></svg>
      </button>
    </div>
    <!-- Phones: a Control Center–style menu -->
    <div id="cc-menu" class="ccm" data-menu hidden>
      <a class="ccm-tile" href="#work"><span class="ccm-ic" style="background:linear-gradient(#8fd0ff,#3b9cf0)"><svg width="20" height="20" viewBox="0 0 28 28" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9 H11 L13 11 H25 V22 H3 Z"></path></svg></span>Work</a>
      <a class="ccm-tile" href="#lab"><span class="ccm-ic" style="background:linear-gradient(#b4f0a8,#33b35a)"><svg width="20" height="20" viewBox="0 0 28 28" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6 H20 M10 6 V13 L5 22 H23 L18 13 V6"></path></svg></span>Lab</a>
      <a class="ccm-tile" href="#about"><span class="ccm-ic" style="background:linear-gradient(#ffd38a,#f59a1b)"><svg width="20" height="20" viewBox="0 0 28 28" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="10" r="4"></circle><path d="M6 23 c1-5 4-7 8-7 s7 2 8 7"></path></svg></span>About</a>
      <a class="ccm-tile" href="#say-hi"><span class="ccm-ic" style="background:linear-gradient(#ffffff,#d9d9df)"><svg width="20" height="20" viewBox="0 0 28 28" fill="none" stroke="#3a3a40" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="7" width="20" height="14" rx="2"></rect><path d="M4 8 L14 15 L24 8"></path></svg></span>Say hi</a>
      <div class="ccm-wide"><NowPlaying /></div>
      <div class="ccm-wide ccm-status"><span class="ccm-dot" aria-hidden="true"></span>{site.status}</div>
    </div>
  </header>

  <!-- ============ Hero ============ -->
  <section id="top" class="hero">
    <div class="hero-in">
      <div class="hero-copy">
        <h1 class="hero-title">Welcome to my space.</h1>
        <p class="hero-text">I'm Abraham, a senior product designer. Everything I make and love lives here: product work, side projects, and the things I do for fun.</p>
        <div class="hero-actions">
          <a class="aqua" href={houseHref}>Step in</a>
          <a class="ghost" href="#work">Just the highlights</a>
          <a class="hero-skim" href="#work">Just the highlights ↓</a>
        </div>
      </div>

      <div class="stage" data-stage>
        <img class="grid" src="/images/iso-grid.webp" alt="" width="2880" height="1720" decoding="async" />
        <a class="house fx" href={houseHref} aria-label="Step into my space">
          <Picture
            src={housePoster}
            formats={['avif', 'webp']}
            widths={[720, 1080, 1440, 1800, 2336]}
            sizes="(max-width: 900px) 120vw, 900px"
            alt="My house, cut into the page: a living room in the middle with a sofa, a checkered rug and me waving, and around it a bedroom, a studio with a bookcase and a treadmill, a lab, and small gardens with trees"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="house-live" data-house-live aria-hidden="true"></div>
        </a>

        <div class="hero-wins" data-panel-host>
          <PeekWin win={wins.pet} h={110} class="fx hw hw-pet" controls="win-modal" />
          <PeekWin win={wins.proto} h={112} class="fx hw hw-proto" controls="win-modal" />
          <div class="panel" data-panel hidden></div>
        </div>

        <button type="button" class="stk fx stk-key" data-drag aria-label="House key, decoration. Drag it, or focus it and use the arrow keys.">
          <span class="keyobj"><svg width="168" height="78" viewBox="0 0 168 78" aria-hidden="true"><g transform="rotate(-8 84 39)"><rect x="4" y="16" width="78" height="44" rx="6" fill="#f4e7c3" stroke="rgba(0,0,0,.18)"/><circle cx="16" cy="38" r="4" fill="#f3f3f5" stroke="rgba(0,0,0,.25)"/><text x="28" y="34" font-family="IBM Plex Mono, monospace" font-size="8.5" letter-spacing=".8" fill="#7a6a3c">KEY NO. 01</text><text x="28" y="49" font-family="Inter, sans-serif" font-weight="600" font-size="12" letter-spacing="-.2" fill="#151517">My space</text><path d="M82 38 C 90 38, 92 30, 100 30" fill="none" stroke="#8a8a90" stroke-width="1.5"/><circle cx="106" cy="30" r="7" fill="none" stroke="#9a9aa2" stroke-width="2.2"/><circle cx="122" cy="34" r="11" fill="#e1aa3f" stroke="#b9852a" stroke-width="1.2"/><circle cx="122" cy="34" r="4" fill="#f3f3f5" stroke="#b9852a" stroke-width="1"/><path d="M131 38 L162 50 L160 55 L156 53.5 L154.5 58 L150 56.3 L151.5 52 L147 50.3 L145.5 54.5 L141 52.8 L143 46 L129 42 Z" fill="#e1aa3f" stroke="#b9852a" stroke-width="1.2" stroke-linejoin="round"/></g></svg></span>
        </button>
        <button type="button" class="stk fx stk-pet" data-drag aria-label="The pet from my game, decoration. Drag it, or focus it and use the arrow keys.">
          <span class="petobj">
            <span class="petheart" aria-hidden="true"><svg width="12" height="10" viewBox="0 0 12 10"><path d="M2 0h3v1h2V0h3v1h1v1h1v3h-1v1h-1v1H9v1H8v1H7v1H5V9H4V8H3V7H2V6H1V5H0V2h1V1h1z" fill="#ff4f8b"/></svg></span>
            <svg class="petsvg" width="60" height="50" viewBox="0 0 12 10" shape-rendering="crispEdges" aria-hidden="true">
              <path fill="#ffad5c" d="M2 0h1v1H2zM9 0h1v1H9zM1 1h2v1H1zM9 1h2v1H9zM1 2h10v1H1zM0 3h12v5H0zM1 8h10v1H1zM2 9h2v1H2zM8 9h2v1H8z"/>
              <path fill="#ff8fa8" d="M1 6h1v1H1zM10 6h1v1h-1z"/>
              <path fill="#7a3b12" d="M5 6h2v1H5z"/>
              <path class="eye" fill="#151517" d="M3 4h1v2H3z"/>
              <path class="eye" fill="#151517" d="M8 4h1v2H8z"/>
            </svg>
            <span class="petshadow"></span>
          </span>
        </button>
      </div>
    </div>
  </section>

  <!-- ============ The work ============ -->
  <section id="work" class="sec home-sec">
    <span id="studio" class="anchor" aria-hidden="true"></span>
    <span class="dotfade"></span>
    <div class="head z">
      <span class="pillk">The work</span>
      <h2 class="big-h2">Things I've shipped</h2>
      <p class="head-p">Product work from Gokomodo and beyond. Each one opens into a short case study.</p>
    </div>
    <div class="wide z grp" data-reveal>
      {lead && (() => {
        const Tag = lead.data.published ? 'a' : 'div';
        return (
          <Tag class:list={['wcard', 'wcard-lead', { 'is-soon': !lead.data.published }]} href={lead.data.published ? `/work/${lead.id}` : undefined}>
            <div class="bar wbar"><span class="lights" aria-hidden="true"><span></span><span></span><span></span></span><span class="fname">{lead.data.short ?? lead.data.company}</span></div>
            {lead.data.thumb ? (
              <div class="wthumb wthumb-lead"><img src={lead.data.thumb} alt="" loading="lazy" decoding="async" style={`object-position:${lead.data.thumbPosition}`} /></div>
            ) : (
              <div class="wthumb wthumb-lead mock" aria-hidden="true">
                <div class="mphone"><span class="mphone-top"></span><span class="mlist">
                  {[...mockRows, ...mockRows, ...mockRows, ...mockRows].map((c) => (
                    <span class="mrow"><span class="mic" style={`background:${c}`}></span><span class="mlines"><i></i><i></i></span><span class="mrp">Rp</span></span>
                  ))}
                </span></div>
              </div>
            )}
            <div class="wtext">
              <div class="wtext-main">
                <span class="wmeta">{metaLine(lead)}</span>
                <span class="wtitle">{lead.data.title}</span>
                <span class="wline">{lead.data.summary}</span>
              </div>
              {lead.data.published && <span class="more">Read →</span>}
            </div>
          </Tag>
        );
      })()}
      <div class="wside">
        {rest.map((w) => {
          const Tag = w.data.published ? 'a' : 'div';
          return (
            <Tag class:list={['wcard', { 'is-soon': !w.data.published }]} href={w.data.published ? `/work/${w.id}` : undefined}>
              <div class="bar wbar"><span class="lights" aria-hidden="true"><span></span><span></span><span></span></span><span class="fname">{w.data.short ?? w.data.company}</span></div>
              <div class="wthumb">
                {w.data.thumb ? <img src={w.data.thumb} alt="" loading="lazy" decoding="async" style={`object-position:${w.data.thumbPosition}`} /> : <span class="wthumb-empty">Coming soon</span>}
              </div>
              <div class="wtext wtext-sm">
                <div class="wtext-main">
                  <span class="wmeta">{metaLine(w)}</span>
                  <span class="wtitle">{w.data.title}</span>
                  <span class="wline">{w.data.summary}</span>
                </div>
                {w.data.published && <span class="more">Read →</span>}
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ The lab ============ -->
  <section id="lab" class="sec home-sec lab" data-anim>
    <span class="dotfade"></span>
    <div class="head z">
      <span class="pillk">The lab</span>
      <h2 class="big-h2">Things I'm figuring out</h2>
      <p class="head-p">Side projects, experiments, and a game that isn't launched yet. Hover to peek, click to open.</p>
    </div>
    <ul class="lab-row z" role="list">
      {labItems.map((it) => (
        <li class="lab-item" data-panel-host data-reveal>
          <PeekWin win={it.win} h={190} class="fx lw" controls="win-modal" />
          <div class="lab-cap"><span class="lab-t">{it.win.title}</span><span class="lab-l">{it.line}</span></div>
          <div class="panel" data-panel hidden></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ About ============ -->
  <section id="about" class="sec home-sec about">
    <span class="dotfade"></span>
    <div class="head z"><span class="pillk">About</span></div>
    <div class="about-in z" data-reveal>
      <article class="info" aria-label={`${site.name} info`}>
        <div class="bar ibar"><span class="lights" aria-hidden="true"><span></span><span></span><span></span></span><span class="fname">{site.name} Info</span></div>
        <div class="ihead">
          <img class="iphoto" src="/images/about/avatar.svg" alt="My character from the house, smiling" width="240" height="240" loading="lazy" decoding="async" />
          <span class="iname-wrap"><span class="iname">{site.name}</span><span class="irole">Senior product designer</span><span class="imod">Modified: <time data-mactime>today</time></span></span>
        </div>
        <ul class="itags" role="list" aria-label="Tags">
          {tags.map(([t, c]) => <li class="itag"><i style={`background:${c}`}></i>{t}</li>)}
        </ul>
        {info.map((s) => (
          <div class="isec">
            <button type="button" class="ihd" aria-expanded="true" aria-controls={`info-${s.id}`} data-disclose>
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M3 2 L7 5 L3 8" fill="none" stroke="#6e6e73" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{s.title}
            </button>
            <div class="ibody" id={`info-${s.id}`}>
              <dl class="igrid">{s.rows.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
            </div>
          </div>
        ))}
        <div class="isec">
          <button type="button" class="ihd" aria-expanded="true" aria-controls="info-comments" data-disclose>
            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M3 2 L7 5 L3 8" fill="none" stroke="#6e6e73" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Comments
          </button>
          <div class="ibody" id="info-comments"><p class="icomment">Everything I make and love lives here. Make yourself at home.</p></div>
        </div>
      </article>
      <NowPlaying heading playlist class="about-cc" />
    </div>
  </section>

  <!-- ============ Say hi ============ -->
  <footer id="say-hi" class="sec home-sec sayhi">
    <span class="dotfade"></span>
    <div class="head z">
      <span class="pillk">Say hi</span>
      <h2 class="huge-h2">Thanks for stopping by</h2>
      <p class="head-p">Hiring, collaborating, or just want to talk about records? The door's open.</p>
      <div class="sayhi-btns"><a class="aqua" href={site.emailHref}>Say hi</a><a class="ghost" href={site.linkedin}>LinkedIn</a></div>
    </div>
    <nav class="dock z" aria-label="Dock">
      <a class="ic" href="#work" style="background:linear-gradient(#8fd0ff,#3b9cf0)"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9 H11 L13 11 H25 V22 H3 Z"></path></svg><span class="tip">Work</span></a>
      <a class="ic" href="#lab" style="background:linear-gradient(#b4f0a8,#33b35a)"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6 H20 M10 6 V13 L5 22 H23 L18 13 V6"></path></svg><span class="tip">Lab</span></a>
      <a class="ic" href={houseHref} style="background:linear-gradient(#ffd38a,#f59a1b)"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13 L14 5 L23 13 V23 H5 Z"></path><path d="M11 23 V17 H17 V23"></path></svg><span class="tip">My space</span></a>
      <a class="ic" href="#about" style="background:linear-gradient(#ff9fb6,#f0436b)"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="3"></circle><circle cx="20" cy="18" r="3"></circle><path d="M12 20 V7 L23 5 V18"></path></svg><span class="tip">Music</span></a>
      <a class="ic" href={site.emailHref} style="background:linear-gradient(#ffffff,#d9d9df)"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#3a3a40" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="7" width="20" height="14" rx="2"></rect><path d="M4 8 L14 15 L24 8"></path></svg><span class="tip">Say hi</span></a>
    </nav>
    <p class="copy z">© 2026 {site.name} · {site.email}</p>
  </footer>

  <!-- ============ Window modal (desktop) ============ -->
  <dialog id="win-modal" class="wm" aria-labelledby="wm-title">
    <div class="bar wm-bar">
      <span class="lights"><button type="button" class="wm-close" aria-label="Close window" data-close></button><span></span><span></span></span>
      <span class="fname" data-wm-file></span>
    </div>
    <div class="wm-media" data-wm-media></div>
    <div class="wm-foot">
      <div class="wm-text"><h3 id="wm-title" data-wm-title></h3><p data-wm-desc></p></div>
      <div class="wm-actions"><a class="aqua wm-cta" data-wm-cta hidden></a><button type="button" class="ghost wm-btn" data-close>Close</button></div>
    </div>
  </dialog>

  <div class="step-pill" aria-hidden="true">Step in →</div>
</Space>

<script>
  /**
   * The live 3D house (House v2, src/house3d/viewer.ts) fades in over the poster.
   *
   * Auto-load only when it's cheap and wanted: after the page is idle AND the hero is on screen.
   * Never on Save-Data, slow connections, low-memory devices, reduced motion, or ?mode=focus;
   * there it waits for intent (hover/focus/touch).
   *
   * "Step in" is a plain link to /house for now: the in-place zoom (house/enter.ts) drives the old
   * house engine, which the hero no longer runs.
   */
  import type { HouseView } from '../house3d/viewer';

  const host = document.querySelector<HTMLElement>('[data-house-live]');
  const link = host?.closest<HTMLElement>('.house');
  if (host && link) {
    type Conn = { saveData?: boolean; effectiveType?: string };
    const nav = navigator as Navigator & { connection?: Conn; deviceMemory?: number };
    const conn = nav.connection;
    const holdBack =
      conn?.saveData ||
      /(^|-)(2g|3g)$/.test(conn?.effectiveType ?? '') ||
      (nav.deviceMemory !== undefined && nav.deviceMemory <= 2) ||
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      document.documentElement.dataset.mode === 'focus';

    let view: Promise<HouseView> | null = null;
    const start = () =>
      (view ??= import('../house3d/viewer').then(({ mountHouse }) => {
        const v = mountHouse(host);
        return v.ready.then(() => {
          link.classList.add('is-live');
          return v;
        });
      }));

    if (holdBack) {
      for (const ev of ['pointerenter', 'focusin', 'touchstart'] as const) link.addEventListener(ev, () => start(), { once: true, passive: true });
    } else {
      const idle = (cb: () => void) =>
        'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 4000 }) : setTimeout(cb, 1500);
      const whenLoaded = (cb: () => void) => (document.readyState === 'complete' ? cb() : addEventListener('load', cb, { once: true }));
      whenLoaded(() =>
        idle(() => {
          const io = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              start();
            }
          });
          io.observe(link);
        }),
      );
    }

    // ---- "Step in →" glass pill follows the cursor over the house ----
    const pill = document.querySelector<HTMLElement>('.step-pill');
    if (pill && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      link.classList.add('has-pill');
      const move = (e: PointerEvent) => (pill.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`);
      link.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        move(e);
        pill.classList.add('is-on');
      });
      link.addEventListener('pointermove', move);
      link.addEventListener('pointerleave', () => pill.classList.remove('is-on'));
    }
  }
</script>

<script>
  /** Menu bar, windows, drag, Get Info, and pausing animation off screen. */
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const narrow = matchMedia('(max-width: 700px)');

  // ---- clock + "Modified" date (Asia/Jakarta) ----
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const mac = document.querySelector<HTMLElement>('[data-mactime]');
  const tick = () => {
    try {
      const tz = { timeZone: 'Asia/Jakarta' } as const;
      if (clock) clock.textContent = new Date().toLocaleTimeString('en-GB', { ...tz, hour: '2-digit', minute: '2-digit' });
      if (mac) mac.textContent = new Date().toLocaleString('en-GB', { ...tz, weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).replace(/,/g, '');
    } catch {}
  };
  tick();
  setInterval(tick, 20000);

  // ---- popovers: now playing (desktop) and the Control Center menu (phones) ----
  const pairs: Array<[HTMLElement | null, HTMLElement | null]> = [
    [document.querySelector('[data-pop-btn]'), document.querySelector('[data-pop]')],
    [document.querySelector('[data-menu-btn]'), document.querySelector('[data-menu]')],
  ];
  const closeAll = (except?: HTMLElement | null) =>
    pairs.forEach(([b, p]) => {
      if (!b || !p || b === except) return;
      b.setAttribute('aria-expanded', 'false');
      p.classList.remove('is-open');
      if (p.hasAttribute('data-menu')) p.hidden = true;
    });
  pairs.forEach(([btn, pop]) => {
    if (!btn || !pop) return;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = btn.getAttribute('aria-expanded') !== 'true';
      closeAll(btn);
      btn.setAttribute('aria-expanded', String(open));
      pop.classList.toggle('is-open', open);
      if (pop.hasAttribute('data-menu')) pop.hidden = !open;
    });
    pop.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) closeAll();
      else e.stopPropagation();
    });
  });
  document.addEventListener('click', () => closeAll());
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = pairs.find(([b]) => b?.getAttribute('aria-expanded') === 'true');
    if (open) {
      closeAll();
      open[0]?.focus();
    }
  });

  // ---- record player pause/play (visual only) ----
  document.querySelectorAll<HTMLButtonElement>('[data-vinyl-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const cc = b.closest('.cc');
      const stopped = cc?.classList.toggle('is-stopped');
      b.setAttribute('aria-label', stopped ? 'Play' : 'Pause');
      b.innerHTML = stopped
        ? '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5 L13 8 L4 13.5 Z" fill="#1d1d1f"></path></svg>'
        : '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3 V13 M11 3 V13" stroke="#1d1d1f" stroke-width="2.4" stroke-linecap="round"></path></svg>';
    }),
  );

  // ---- windows: modal on desktop, inline panel on phones ----
  type Win = { kind: string; file: string; title: string; desc: string; cta?: string; href?: string };
  const modal = document.getElementById('win-modal') as HTMLDialogElement | null;
  let opener: HTMLElement | null = null;
  const fill = (root: ParentNode, w: Win, media: Element | null) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s);
    const f = q('[data-wm-file]'); if (f) f.textContent = w.file;
    const t = q('[data-wm-title]'); if (t) t.textContent = w.title;
    const d = q('[data-wm-desc]'); if (d) d.textContent = w.desc;
    const c = q<HTMLAnchorElement>('[data-wm-cta]');
    if (c) { c.hidden = !w.href; if (w.href) { c.href = w.href; c.textContent = w.cta ?? 'Open'; } }
    const m = q('[data-wm-media]');
    if (m) m.replaceChildren(...(media ? [media.cloneNode(true)] : []));
  };
  document.querySelectorAll<HTMLButtonElement>('[data-win]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const w = JSON.parse(btn.dataset.win!) as Win;
      const media = btn.querySelector('.peek');
      const hostEl = btn.closest<HTMLElement>('[data-panel-host]');
      const panel = hostEl?.querySelector<HTMLElement>('[data-panel]');
      if (narrow.matches && panel) {
        const same = panel.dataset.for === w.title && !panel.hidden;
        hostEl!.querySelectorAll('[data-win]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
        if (same) { panel.hidden = true; return; }
        panel.dataset.for = w.title;
        panel.innerHTML = `<p class="panel-t" data-wm-title></p><p class="panel-d" data-wm-desc></p><a class="aqua panel-cta" data-wm-cta hidden></a>`;
        fill(panel, w, null);
        panel.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
        if (!panel.id) panel.id = `panel-${Math.random().toString(36).slice(2, 8)}`;
        btn.setAttribute('aria-controls', panel.id);
        return;
      }
      if (!modal) return;
      opener = btn;
      fill(modal, w, media);
      modal.showModal();
    }),
  );
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal || (e.target as Element).closest('[data-close]')) modal.close();
    });
    modal.addEventListener('close', () => opener?.focus());
  }

  // ---- draggable key and pet: pointer, or focus + arrow keys (8px; Shift = 32px) ----
  document.querySelectorAll<HTMLElement>('[data-drag]').forEach((el) => {
    let x = 0, y = 0;
    const apply = () => el.style.setProperty('--dx', `${x}px`), applyY = () => el.style.setProperty('--dy', `${y}px`);
    el.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
      el.setPointerCapture(e.pointerId);
      el.classList.add('is-drag');
      const sx = e.clientX - x, sy = e.clientY - y;
      const move = (ev: PointerEvent) => { x = ev.clientX - sx; y = ev.clientY - sy; apply(); applyY(); };
      const up = () => { el.classList.remove('is-drag'); el.removeEventListener('pointermove', move); el.removeEventListener('pointerup', up); el.removeEventListener('pointercancel', up); };
      el.addEventListener('pointermove', move);
      el.addEventListener('pointerup', up);
      el.addEventListener('pointercancel', up);
    });
    el.addEventListener('keydown', (e) => {
      const s = e.shiftKey ? 32 : 8;
      const d: Record<string, [number, number]> = { ArrowLeft: [-s, 0], ArrowRight: [s, 0], ArrowUp: [0, -s], ArrowDown: [0, s] };
      if (!d[e.key]) return;
      e.preventDefault();
      x += d[e.key][0]; y += d[e.key][1]; apply(); applyY();
    });
  });

  // ---- Get Info disclosures ----
  document.querySelectorAll<HTMLButtonElement>('[data-disclose]').forEach((b) =>
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      const body = document.getElementById(b.getAttribute('aria-controls')!);
      if (body) body.hidden = !open;
    }),
  );

  // ---- pause looping animations while their section is off screen ----
  if (!reduce) {
    const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-paused', !e.isIntersecting)));
    document.querySelectorAll('.hero, .lab, .about, .mb').forEach((s) => io.observe(s));
  }

  // ---- reveal on scroll ----
  const rio = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); rio.unobserve(e.target); } }),
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => rio.observe(el));
</script>

<style>
