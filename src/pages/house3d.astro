---
// Internal preview of the Pinwheel house GLB (House v2), framed like reference/hero_P2.png. Not linked anywhere.
// Light can be tried from the URL: /house3d?sun=2.2&ambient=1.1&lamp=1
// ?bare (the poster render, scripts/render-house3d-poster.mjs) or ?still: character and pet at rest, not moving.
// ?wave: the character waves (window.__house.greet(true / false) toggles it).
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Pinwheel house</title>
    <style>
      html, body { margin: 0; height: 100%; background: #f3f3f5; }
      html.bare, html.bare body { background: transparent; }
      #house { position: fixed; inset: 24px; }
      html.bare #house { inset: 0; }
    </style>
  </head>
  <body>
    <div id="house"></div>
    <script>
      import { mountHouse, LIGHT } from '../house3d/viewer';
      const q = new URLSearchParams(location.search);
      if (q.has('bare')) document.documentElement.classList.add('bare');
      const light = { ...LIGHT };
      for (const k of Object.keys(light) as (keyof typeof LIGHT)[]) {
        const v = parseFloat(q.get(k) ?? '');
        if (!Number.isNaN(v)) light[k] = v;
      }
      const view = mountHouse(document.getElementById('house')!, { light, still: q.has('bare') || q.has('still') });
      (window as any).__house = view;
      view.ready.then(() => { if (q.has('wave')) view.greet(true); (window as any).__houseReady = true; }, (e) => { console.error(e); (window as any).__houseError = String(e); });
    </script>
  </body>
</html>
