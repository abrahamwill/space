---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HouseApp from '../house/HouseApp';
import type { HouseContent } from '../house/content';
import { site, lab, about } from '../data/site';
import posterDim from '../assets/house/poster-dim.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const content: HouseContent = {
  site: { name: site.name, email: site.email, emailHref: site.emailHref, linkedin: site.linkedin, cv: site.cv },
  featured: work.map((w) => ({
    slug: w.id,
    title: w.data.title,
    summary: w.data.summary,
    company: w.data.company,
    role: w.data.role,
    year: w.data.year,
    published: w.data.published,
    cover: w.data.cover,
    tldr: w.data.tldr,
    metrics: w.data.metrics,
    prototypeUrl: w.data.prototypeUrl,
  })),
  lab,
  about,
};
---
<Base title="The house" description="Step inside: a studio full of work, a lab of side projects, and the room I live in." bare>
  <h1 class="sr-only">The house</h1>
  <!-- First paint: a still of the arrival state. The 3D house fades in over it. -->
  <div class="house-poster" aria-hidden="true">
    <Picture src={posterDim} formats={['avif', 'webp']} widths={[960, 1440, 2400]} sizes="100vw" alt="" loading="eager" fetchpriority="high" />
  </div>
  <HouseApp client:only="react" content={content} />
  <noscript>
    <div class="house-noscript">
      <p>The house needs JavaScript. The short tour has everything:</p>
      <p><a href="/#studio">The studio</a> · <a href="/#lab">The lab</a> · <a href="/#about">The main room</a></p>
    </div>
  </noscript>
</Base>

<style>
  .house-poster {
    position: fixed;
    inset: 96px 32px 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .house-poster :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  @media (max-width: 899px) { .house-poster { inset: 136px 32px 32px; } }
  .house-noscript {
    position: fixed; left: 0; right: 0; bottom: 0; padding: 24px 32px;
    background: var(--page); display: flex; flex-direction: column; gap: 8px;
  }
</style>
