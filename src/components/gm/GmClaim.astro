---
/**
 * "Start by creating your personal link": a working copy of the claim screen and its three states
 * from the Figma file (empty, too short with the file's error copy, valid with the mint check).
 * Autoplays a short typing demo until the visitor touches the field.
 */
import './gm-ui.css';
---
<div class="claim-wrap" data-gm-claim>
  <div class="claim gmui">
    <span class="claim-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#0b2a20" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
    </span>
    <p class="claim-title"><span class="m">Start</span> by creating your personal <span class="m">link</span></p>
    <p class="claim-sub">Share your profile with your audience and receive tips effortlessly.</p>

    <label class="field" data-field data-state="empty">
      <span class="pre">gm.xyz/</span>
      <input data-input type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="24" placeholder="yourname" aria-label="Your gm.xyz link" aria-describedby="gm-claim-msg" />
      <svg class="ok" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1"/></svg>
    </label>
    <p class="msg" id="gm-claim-msg" aria-live="polite" data-msg></p>

    <button class="gm-btn claim-btn" type="button" disabled data-btn>Create my Link</button>
    <p class="claim-note" data-note hidden>In the product, this goes on to your name, profession and bio.</p>
  </div>

  <ol class="legend" role="list" aria-label="States of the link field">
    <li data-key="empty"><b>Empty</b><span>The prefix is always visible, so people see the link they're making, not a blank box.</span></li>
    <li data-key="short"><b>Too short</b><span>“Whoops, your link must be at least 5 characters long.” The rule is in the message, not just a red border.</span></li>
    <li data-key="ok"><b>Ready</b><span>A mint check in the field and the button wakes up. Nothing else on the screen competes with it.</span></li>
  </ol>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ERROR = 'Whoops, your link must be at least 5 characters long.';
  document.querySelectorAll<HTMLElement>('[data-gm-claim]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const field = root.querySelector<HTMLElement>('[data-field]')!;
    const msg = root.querySelector<HTMLElement>('[data-msg]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-btn]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    const legend = [...root.querySelectorAll<HTMLElement>('[data-key]')];

    const render = () => {
      const v = input.value;
      const state = v.length === 0 ? 'empty' : v.length < 5 ? 'short' : 'ok';
      field.dataset.state = state;
      input.setAttribute('aria-invalid', String(state === 'short'));
      msg.textContent = state === 'short' ? ERROR : '';
      btn.disabled = state !== 'ok';
      legend.forEach((li) => li.classList.toggle('is-on', li.dataset.key === state));
      note.hidden = true;
    };
    input.addEventListener('input', () => {
      const clean = input.value.toLowerCase().replace(/[^a-z0-9_]/g, '');
      if (clean !== input.value) input.value = clean;
      render();
    });
    btn.addEventListener('click', () => { note.hidden = false; });
    render();

    // Typing demo, until the visitor takes over.
    let auto = !reduce, visible = false;
    const takeOver = () => { auto = false; };
    input.addEventListener('focus', takeOver);
    input.addEventListener('pointerdown', takeOver);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);

    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    const until = async () => { while (auto && (!visible || document.hidden)) await wait(300); };
    const typeTo = async (target: string) => {
      while (auto && input.value !== target) {
        await until();
        if (!auto) return;
        const v = input.value;
        input.value = target.startsWith(v) ? target.slice(0, v.length + 1) : v.slice(0, -1);
        render();
        await wait(target.startsWith(v) ? 95 : 45);
      }
    };
    const run = async () => {
      while (auto) {
        await typeTo('luke'); await wait(1700);
        await typeTo('lukemoradavis'); await wait(2400);
        await typeTo(''); await wait(700);
      }
    };
    if (auto) run();
  });
</script>

<style>
  .claim-wrap { display: grid; grid-template-columns: minmax(0, 400px) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .claim {
    display: flex; flex-direction: column; gap: 16px;
    padding: 34px 26px 30px; border-radius: 28px;
    background: linear-gradient(160deg, #1d2422 0%, #111 38%, #050505 100%);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .06), 0 30px 70px rgba(0, 0, 0, .25);
  }
  .claim-icon { display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; background: var(--gm-mint); margin-bottom: 10px; box-shadow: 0 10px 30px rgba(128, 255, 214, .25); }
  .claim-title { margin: 0; font-weight: 700; font-size: 32px; line-height: 1.08; letter-spacing: -.03em; color: #fff; }
  .claim-title .m { color: var(--gm-mint); }
  .claim-sub { margin: 0; font-size: 15px; line-height: 1.5; color: var(--gm-soft); }

  .field {
    display: flex; align-items: center; gap: 2px; min-height: 56px; margin-top: 10px; padding: 0 16px;
    border-radius: 12px; background: #1c1c1c; box-shadow: inset 0 0 0 1px #1c1c1c;
    cursor: text; transition: box-shadow .2s;
  }
  .field:focus-within { box-shadow: inset 0 0 0 1px #3a3a3a; }
  .field[data-state='short'] { box-shadow: inset 0 0 0 1px rgba(255, 93, 93, .7); }
  .pre { color: var(--gm-muted); font-size: 17px; }
  .field input { flex: 1; min-width: 0; height: 52px; border: 0; padding: 0 0 0 2px; background: transparent; color: #fff; font: 400 17px 'Geist Variable', system-ui, sans-serif; outline: none; }
  .field input::placeholder { color: #555; }
  .ok { color: var(--gm-mint); flex: none; }
  .ok path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .35s var(--gm-ease); }
  .field[data-state='ok'] .ok path { stroke-dashoffset: 0; }
  .msg { min-height: 1.4em; margin: -6px 0 0; font-size: 13px; line-height: 1.4; color: var(--gm-red); }
  .claim-btn { width: 100%; min-height: 54px; font-size: 17px; }
  .claim-note { margin: 0; font-size: 13px; color: var(--gm-muted); text-align: center; }

  .legend { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .legend li { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border-radius: 12px; background: #fff; box-shadow: var(--hair); transition: box-shadow .25s, transform .25s var(--ease); }
  .legend li.is-on { box-shadow: 0 0 0 2px var(--blue); }
  .legend b { font-weight: 600; font-size: 15px; }
  .legend span { font-size: 15px; line-height: 1.5; color: var(--ink-2); }

  @media (max-width: 820px) { .claim-wrap { grid-template-columns: minmax(0, 1fr); } .claim { max-width: 420px; } }
  @media (prefers-reduced-motion: reduce) { .ok path { transition: none; } }
</style>
