---
/**
 * One profile, three visitors: the Figma file's "Profile State" section as a switcher.
 * The header pills and the closing call to action change with who is looking; the profile itself never does.
 */
import './gm-ui.css';

const states = [
  { id: '1', tab: 'Not signed in', label: 'User have not logged in and visit other people link', note: 'A stranger sees one way in: connect a wallet. The page still sells the product at the bottom.' },
  { id: '2', tab: 'Signed in, no link', label: 'User logged in but haven’t create their own gm link', note: 'The wallet is connected, so the header shows it. The ask stays the same: make your own link.' },
  { id: '3', tab: 'Has a link', label: 'User created his gm link and looking into other people profile', note: 'Now the page stops selling. The header and the last button take you home to your own page.' },
];
---
<div class="viewers" data-gm-viewers>
  <div class="vw-controls">
    <div class="vw-tabs" role="tablist" aria-label="Who is looking at the profile">
      {states.map((s, i) => (
        <button type="button" role="tab" id={`vw-tab-${s.id}`} aria-controls="vw-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-state={s.id}>
          <span class="vw-n">{s.id}</span>{s.tab}
        </button>
      ))}
    </div>
    <div class="vw-notes" aria-live="polite">
      {states.map((s, i) => (
        <div class:list={['vw-note', { 'is-on': i === 0 }]} data-note={s.id}>
          <span class="vw-label">“{s.label}”</span>
          <p>{s.note}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="vw-card gmui" id="vw-panel" role="tabpanel" aria-labelledby="vw-tab-1" data-panel data-current="1">
    <div class="vw-top">
      <img class="vw-avatar" src="/images/work/gm-xyz/avatar.webp" alt="" width="216" height="216" loading="lazy" decoding="async" />
      <div class="vw-actions">
        <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3M8 7l4-4 4 4"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg></span>
        <span class="pill wallet" data-s="1"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="3"/><path d="M16 12.5h2"/></svg>Connect Wallet</span>
        <span class="pill addr" data-s="2 3"><span class="dot" aria-hidden="true"></span>0x214AP95...</span>
        <span class="pill mine" data-s="3">My Page</span>
      </div>
    </div>
    <p class="vw-name">Luke <span>Moradavis</span></p>
    <p class="vw-role">🧑‍💻 Software Engineer @Techtonix</p>
    <span class="vw-coffee"><span class="cup" aria-hidden="true" set:html={'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#80FFD6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M16 10.5h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3.5c0 1 1 1.5 1 2.5M12 3.5c0 1 1 1.5 1 2.5"/></svg>'} />Shout me a Coffee</span>
    <div class="vw-seg" aria-hidden="true"><span class="on">Links</span><span>Projects</span></div>
    <ul class="vw-links" role="list">
      <li><span class="li-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M4 3h17v11l-5 5h-4l-3 3H7v-3H3V6zm2 2v11h3v2.5L11.5 16H16l3-3V5zm5 3h2v5h-2zm5 0h2v5h-2z"/></svg></span><span class="li-t"><b>Twitch</b><span>twitch.com/lukemoradavis</span></span></li>
      <li><span class="li-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7 3.6 3.6 0 0 1 .1-2.7s.9-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .6 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/></svg></span><span class="li-t"><b>Github</b><span>github.com/lukemoradavis</span></span></li>
    </ul>
    <span class="vw-cta" data-s="1 2">Create your gm link <span aria-hidden="true">→</span></span>
    <span class="vw-cta" data-s="3">Go to my gm page <span aria-hidden="true">→</span></span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gm-viewers]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const notes = [...root.querySelectorAll<HTMLElement>('[data-note]')];
    const select = (i: number, focus = false) => {
      const tab = tabs[(i + tabs.length) % tabs.length];
      const id = tab.dataset.state!;
      const before = new Set([...panel.querySelectorAll<HTMLElement>('[data-s]')].filter((el) => el.offsetParent !== null));
      tabs.forEach((t) => { const on = t === tab; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      panel.dataset.current = id;
      panel.setAttribute('aria-labelledby', tab.id);
      notes.forEach((n) => n.classList.toggle('is-on', n.dataset.note === id));
      panel.querySelectorAll<HTMLElement>('[data-s]').forEach((el) => {
        if (el.offsetParent !== null && !before.has(el)) { el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash'); }
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = tabs.indexOf(t);
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); select(k + 1, true); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); select(k - 1, true); }
      });
    });
  });
</script>

<style>
  .viewers { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 380px); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .vw-controls { display: flex; flex-direction: column; gap: 22px; }
  .vw-tabs { display: flex; flex-direction: column; gap: 8px; }
  .vw-tabs button { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 16px; border: 0; border-radius: 12px; background: #fff; box-shadow: var(--hair); color: var(--ink); font: 500 16px var(--sans); text-align: left; cursor: pointer; transition: box-shadow .2s, transform .2s var(--ease); }
  .vw-tabs button:hover { transform: translateX(2px); }
  .vw-tabs button[aria-selected='true'] { box-shadow: 0 0 0 2px var(--blue); }
  .vw-n { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--page); font: 600 12px var(--mono); color: var(--muted); }
  .vw-tabs button[aria-selected='true'] .vw-n { background: var(--blue); color: #fff; }
  .vw-notes { display: grid; }
  .vw-note { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 8px; opacity: 0; transform: translateY(6px); transition: opacity .3s, transform .35s var(--ease); visibility: hidden; }
  .vw-note.is-on { opacity: 1; transform: none; visibility: visible; }
  .vw-label { font-family: var(--mono); font-size: 12px; line-height: 1.5; color: var(--muted); }
  .vw-note p { font-size: 17px; }

  .vw-card {
    display: flex; flex-direction: column; gap: 14px; padding: 26px 22px 24px; border-radius: 28px;
    background: linear-gradient(170deg, #1c2421 0%, #111 40%, #050505 100%);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .05), 0 40px 80px rgba(0, 0, 0, .28);
  }
  .vw-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .vw-avatar { width: 72px; height: 72px; border-radius: 50%; box-shadow: 0 0 0 2px #1f3a31; }
  .vw-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 6px; }
  .ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #1f3a31; color: var(--gm-mint); }
  .pill { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border-radius: 999px; font-size: 13px; white-space: nowrap; }
  .pill.wallet { background: #1f3a31; color: var(--gm-mint); }
  .pill.addr { background: #1c1c1c; color: #ddd; box-shadow: inset 0 0 0 1px #2c2c2c; }
  .pill.addr .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gm-sol); }
  .pill.mine { background: transparent; color: var(--gm-mint); box-shadow: inset 0 0 0 1.5px var(--gm-mint); }
  .vw-name { margin: 6px 0 0; font-weight: 700; font-size: 32px; letter-spacing: -.03em; line-height: 1; color: #fff; }
  .vw-name span { color: var(--gm-mint); }
  .vw-role { margin: 0; font-size: 14px; color: #ddd; }
  .vw-coffee { align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 18px 0 5px; border-radius: 999px; background: var(--gm-mint); color: #071a13; font-weight: 500; font-size: 16px; box-shadow: 0 8px 28px rgba(128, 255, 214, .28); }
  .cup { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: #0c0c0c; font-size: 18px; }
  .vw-seg { display: inline-flex; align-self: flex-start; gap: 2px; padding: 4px; margin-top: 4px; border-radius: 999px; background: #0a0a0a; font-size: 14px; color: var(--gm-soft); }
  .vw-seg span { padding: 6px 14px; border-radius: 999px; }
  .vw-seg .on { background: #262626; color: #fff; font-weight: 600; }
  .vw-links { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .vw-links li { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 12px; background: #161616; box-shadow: inset 0 0 0 1px #242424; }
  .li-ic { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 8px; background: #262626; color: #fff; }
  .li-t { display: flex; flex-direction: column; gap: 2px; }
  .li-t b { font-weight: 500; font-size: 15px; }
  .li-t span { font-size: 12px; color: var(--gm-muted); }
  .vw-cta { align-self: center; display: inline-flex; align-items: center; gap: 8px; height: 42px; margin-top: 6px; padding: 0 20px; border-radius: 999px; color: var(--gm-mint); box-shadow: inset 0 0 0 1.5px var(--gm-mint); font-size: 15px; }

  [data-s] { display: none !important; }
  [data-current='1'] [data-s~='1'], [data-current='2'] [data-s~='2'], [data-current='3'] [data-s~='3'] { display: inline-flex !important; }
  .flash { animation: flash 1s var(--gm-ease); }
  @keyframes flash { 0% { transform: scale(.85); opacity: 0; box-shadow: 0 0 0 0 rgba(128, 255, 214, .6); } 40% { transform: scale(1.04); opacity: 1; } 100% { transform: none; box-shadow: 0 0 0 12px rgba(128, 255, 214, 0); } }
  .pill.addr.flash, .pill.wallet.flash { animation-name: flash; }

  @media (max-width: 820px) { .viewers { grid-template-columns: minmax(0, 1fr); } .vw-card { max-width: 400px; } }
  @media (prefers-reduced-motion: reduce) { .flash { animation: none; } .vw-note { transition: none; } }
</style>
