---
import { site, houseHref } from '../data/site';
---
<header class="container site-header">
  <a href="/" class="quiet name">{site.name}</a>
  <nav aria-label="Main">
    <a class="quiet" href="/#studio">Studio</a>
    <a class="quiet" href="/#lab">Lab</a>
    <a class="quiet" href="/#about">About</a>
    <a class="quiet inside" href={houseHref}><span class="dot" aria-hidden="true"></span>Step inside</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    justify-content: space-between;
    align-items: center;
    padding-block: 28px;
  }
  .name { font-weight: 700; font-size: 16px; }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px clamp(18px, 3vw, 32px);
    font-size: 15px;
  }
  nav a { padding-block: 6px; }
  .inside { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--red); }
</style>
