---
/**
 * Square record-sleeve cover in the Bauhaus palette.
 * Drawn as SVG so it stays crisp at any size and costs nothing to load.
 */
interface Props {
  variant: 'sun' | 'moon' | 'mast';
  label?: string;
  class?: string;
}
const { variant, label, class: className } = Astro.props;
const bg = { sun: 'var(--mustard)', moon: 'var(--cobalt)', mast: 'var(--red)' }[variant];
const labelX = variant === 'mast' ? 24 : 6;
---
<div class:list={['cover', className]} style={`background:${bg}`} aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
    {variant === 'sun' && (
      <>
        <circle cx="39" cy="39" r="29" fill="var(--red)" />
        <rect x="0" y="77" width="100" height="9" fill="var(--ink)" />
        <circle cx="77" cy="57" r="13" fill="var(--cobalt)" />
      </>
    )}
    {variant === 'moon' && (
      <>
        <circle cx="50" cy="44" r="28" fill="var(--mustard)" />
        <path d="M50 16 A28 28 0 0 1 50 72 Z" fill="var(--page)" />
      </>
    )}
    {variant === 'mast' && (
      <>
        <circle cx="80" cy="20" r="40" fill="var(--page)" />
        <rect x="10" y="0" width="9" height="100" fill="var(--ink)" />
        <rect x="30" y="52" width="30" height="30" fill="var(--mustard)" />
      </>
    )}
  </svg>
  {label && <span class="cover-label label" style={`left:${labelX}%`}>{label}</span>}
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    container-type: inline-size;
  }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cover-label {
    position: absolute;
    bottom: 3.5%;
    color: var(--page);
    font-size: clamp(11px, 3.4cqi, 14px);
    letter-spacing: 0.18em;
  }
</style>
