---
/**
 * Black-bezel phone whose screen scrolls inside (GokoMart "Phone" part from space-kit).
 * Keyboard focusable so the screen can be scrolled with arrow keys. The hint fades on hover/focus.
 * With `auto`, the screen drifts down and back on its own while visible (off under reduced motion).
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Visible screen height in px at the default 300px width. */
  screen?: number;
  hint?: boolean;
  auto?: boolean;
  class?: string;
}
const { src, alt, width, height, screen = 600, hint = true, auto = false, class: className } = Astro.props;
const tall = height / width > screen / 280 + 0.05;
---
<div class:list={['phone', className]} data-phone={auto ? 'auto' : ''}>
  <div class="phone-screen" tabindex={tall ? 0 : undefined} role={tall ? 'region' : undefined} aria-label={tall ? `${alt} (scrollable)` : undefined} style={`--screen:${screen}px`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  {tall && hint && <span class="phone-hint" aria-hidden="true">Scroll inside ↓</span>}
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-phone="auto"]').forEach((phone) => {
      const screen = phone.querySelector<HTMLElement>('.phone-screen');
      if (!screen) return;
      let dir = 1, raf = 0, visible = false, held = false, last = 0;
      const step = (t: number) => {
        raf = requestAnimationFrame(step);
        if (!visible || held) { last = t; return; }
        const dt = Math.min(48, t - (last || t)); last = t;
        const max = screen.scrollHeight - screen.clientHeight;
        if (max <= 0) return;
        screen.scrollTop += dir * dt * 0.045;
        if (screen.scrollTop >= max - 1) dir = -1;
        if (screen.scrollTop <= 0) dir = 1;
      };
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(phone);
      const hold = () => { held = true; };
      const release = () => { held = false; };
      phone.addEventListener('pointerenter', hold);
      phone.addEventListener('pointerleave', release);
      phone.addEventListener('focusin', hold);
      phone.addEventListener('focusout', release);
      raf = requestAnimationFrame(step);
    });
  }
</script>

<style>
  .phone { position: relative; width: 300px; max-width: 100%; padding: 10px; border-radius: 46px; background: #0b0b0c; box-shadow: inset 0 0 0 1.5px #2b2b2f, 0 0 0 1px rgba(0, 0, 0, .5), 0 30px 60px rgba(0, 0, 0, .22), 0 8px 18px rgba(0, 0, 0, .14); }
  .phone-screen { height: var(--screen); max-height: 78vh; overflow-y: auto; border-radius: 37px; background: #000; scrollbar-width: none; overscroll-behavior: contain; }
  .phone-screen::-webkit-scrollbar { display: none; }
  .phone-screen img { display: block; width: 100%; height: auto; }
  .phone-hint { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); padding: 5px 11px; border-radius: 999px; background: rgba(20, 20, 22, .78); color: #fff; font-size: 12px; white-space: nowrap; pointer-events: none; transition: opacity .25s; backdrop-filter: blur(6px); }
  .phone:hover .phone-hint, .phone:focus-within .phone-hint { opacity: 0; }
</style>
