---
/** Small inline icons for the coded NusaFinance demos. Line icons in the style of the app's nav. */
interface Props {
  name: 'grid' | 'trend' | 'db' | 'bank' | 'swap' | 'wallet' | 'contact' | 'scan' | 'chev' | 'gear' | 'star' | 'eth' | 'lock' | 'link' | 'discord' | 'home' | 'arrows' | 'user' | 'face' | 'id' | 'check' | 'x';
  size?: number;
}
const { name, size = 16 } = Astro.props;
const s = { width: size, height: size, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': 1.8, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' } as const;
---
{name === 'grid' && <svg {...s}><rect x="4" y="4" width="6.5" height="6.5" rx="1.2" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2" /></svg>}
{name === 'trend' && <svg {...s}><path d="M3 17 9 11l4 4 8-8" /><path d="M15 7h6v6" /></svg>}
{name === 'db' && <svg {...s}><ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" /><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" /></svg>}
{name === 'bank' && <svg {...s}><path d="M3 10h18L12 4 3 10Z" /><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18" /></svg>}
{name === 'swap' && <svg {...s}><path d="M7 4v16M7 4 4 7M7 4l3 3" /><path d="M17 20V4M17 20l-3-3M17 20l3-3" /></svg>}
{name === 'wallet' && <svg {...s}><rect x="3" y="6" width="18" height="13" rx="2" /><path d="M3 9h18M16 14h2" /></svg>}
{name === 'contact' && <svg {...s}><rect x="4" y="3" width="16" height="18" rx="2" /><circle cx="12" cy="10" r="2.6" /><path d="M8 17c.8-1.9 2.2-2.8 4-2.8s3.2.9 4 2.8" /></svg>}
{name === 'scan' && <svg {...s}><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16" /></svg>}
{name === 'chev' && <svg {...s}><path d="m6 9 6 6 6-6" /></svg>}
{name === 'gear' && <svg {...s}><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>}
{name === 'star' && <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" /><path d="m12 6.8 1.6 3.3 3.6.5-2.6 2.5.6 3.6-3.2-1.7-3.2 1.7.6-3.6-2.6-2.5 3.6-.5Z" fill="#101010" /></svg>}
{name === 'eth' && <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#627eea" /><path d="M12 4v6l5 2.2Z" fill="#fff" opacity=".6" /><path d="M12 4 7 12.2l5-2.2Z" fill="#fff" /><path d="M12 16v4l5-7Z" fill="#fff" opacity=".6" /><path d="M12 20v-4l-5-3Z" fill="#fff" /></svg>}
{name === 'lock' && <svg {...s}><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>}
{name === 'link' && <svg {...s}><path d="M14 4h6v6M20 4l-9 9" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>}
{name === 'discord' && <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.3 5.3A16.6 16.6 0 0 0 15.2 4l-.5 1a15.4 15.4 0 0 0-5.4 0l-.5-1a16.6 16.6 0 0 0-4.1 1.3C2.1 9.2 1.4 13 1.7 16.7a16.8 16.8 0 0 0 5.1 2.6l1.1-1.7a10.8 10.8 0 0 1-1.7-.8l.4-.3a11.9 11.9 0 0 0 10.8 0l.4.3c-.5.3-1.1.6-1.7.8l1.1 1.7a16.7 16.7 0 0 0 5.1-2.6c.4-4.3-.7-8-3-11.4ZM8.5 14.5c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm7 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z" /></svg>}
{name === 'home' && <svg {...s}><path d="M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1Z" /></svg>}
{name === 'arrows' && <svg {...s}><path d="M4 8h13l-3-3M20 16H7l3 3" /></svg>}
{name === 'user' && <svg {...s}><circle cx="12" cy="8" r="4" /><path d="M4 21c1.3-3.8 4.2-5.6 8-5.6s6.7 1.8 8 5.6" /></svg>}
{name === 'face' && <svg {...s}><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3" /><circle cx="12" cy="10" r="2.6" /><path d="M8 17c.8-1.9 2.2-2.8 4-2.8s3.2.9 4 2.8" /></svg>}
{name === 'id' && <svg {...s}><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="11" r="2" /><path d="M6 16c.6-1.3 1.6-2 3-2s2.4.7 3 2M14 10h4M14 13h3" /></svg>}
{name === 'check' && <svg {...s} stroke-width="2.6"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>}
{name === 'x' && <svg {...s} stroke-width="2.2"><path d="M6 6l12 12M18 6 6 18" /></svg>}
