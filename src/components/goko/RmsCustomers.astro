---
/**
 * RMS (head office backoffice) customer list, coded from the release frame.
 * Autoplay tells decision 1: a farmer signed up at the counter lands in the same list as app sign-ups,
 * marked with the door and the clerk, "Belum aktivasi". The clerk adds coins; the account is already real.
 * Then the farmer signs in to the app with the same phone number and the row turns "Aktif".
 * Names, numbers and amounts are design mock data from the frame.
 */
import './goko-ui.css';

const rows = [
  ['Agung Kurniawan', '+62 812-3456-7890', 'SPG Portal', 'Siska Amalia', '12,400', '4', 'on'],
  ['Budi Santoso', '+62 876-5432-1098', 'Aplikasi', '', '2,500', '0', 'on'],
  ['Dian Pratiwi', '+62 857-6543-2109', 'Aplikasi', '', '5,000', '2', 'on'],
  ['Eko Kusuma', '+62 821-8765-4321', 'Aplikasi', '', '200', '1', 'off'],
  ['Indah Fitriani', '+62 888-1234-5678', 'Aplikasi', '', '5,500', '2', 'on'],
  ['Mayang Sari', '+62 822-7890-1234', 'SPG Portal', 'Siska Amalia', '0', '0', 'new'],
] as const;
const label = { on: 'AKTIF', off: 'TIDAK AKTIF', new: 'BELUM AKTIVASI' } as const;
const nav = [
  ['Customer', '<circle cx="10" cy="7" r="3.2"/><path d="M3.5 17c.8-3.4 3.4-5 6.5-5s5.7 1.6 6.5 5"/>'],
  ['Misi & Games', '<circle cx="10" cy="10" r="7"/><circle cx="10" cy="10" r="4"/><circle cx="10" cy="10" r="1"/>'],
  ['Voucher', '<path d="M3 6h14v2.5a1.5 1.5 0 0 0 0 3V14H3v-2.5a1.5 1.5 0 0 0 0-3z"/><path d="M8 6v8" stroke-dasharray="1.5 1.5"/>'],
  ['GokoHub', '<rect x="3" y="8" width="6" height="9"/><rect x="11" y="4" width="6" height="13"/>'],
  ['Publikasi', '<path d="M4 8v4h3l6 4V4L7 8z"/>'],
];
---
<div class="gk rms" data-rms>
  <aside class="rms-side" aria-hidden="true">
    <span class="rms-logo"><b><i>go</i>komodo</b><span>dashboard</span></span>
    <span class="rms-sec">GOKOMODO APPS</span>
    {nav.map(([n, d], i) => (
      <span class:list={['rms-nav', { on: i === 0 }]}><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" set:html={d}></svg>{n}</span>
    ))}
  </aside>
  <div class="rms-main">
    <div class="rms-top" aria-hidden="true"><span class="rms-user"><span class="rms-av">M</span>Megan</span></div>
    <div class="rms-body">
      <p class="rms-h">Customer</p>
      <div class="rms-bar" aria-hidden="true">
        <span class="gk-field rms-search"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="#9a9aa0" stroke-width="1.5"><circle cx="7" cy="7" r="5"/><path d="m11 11 3.5 3.5"/></svg><span class="pre">Cari nama/no. handphone customer</span></span>
        <span class="rms-filter"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 4h12M2 8h12M2 12h12"/><circle cx="5" cy="4" r="1.5" fill="#fff"/><circle cx="10" cy="8" r="1.5" fill="#fff"/><circle cx="6" cy="12" r="1.5" fill="#fff"/></svg>Filter</span>
      </div>
      <div class="rms-table" role="table" aria-label="Customers from both doors">
        <div class="rms-tr th" role="row"><span role="columnheader">Customer</span><span role="columnheader">Pendaftaran Melalui</span><span role="columnheader" class="num">Jumlah GokoKoins</span><span role="columnheader" class="num c-vc">Jumlah Voucher</span><span role="columnheader">Status</span></div>
        <div class="rms-rows" data-rows>
          {rows.map(([n, tel, via, by, coins, vc, st]) => (
            <div class="rms-tr" role="row">
              <span role="cell" class="rms-who"><b>{n}</b><small>{tel}</small></span>
              <span role="cell" class="rms-via">{via}{by && <small>oleh {by}</small>}</span>
              <span role="cell" class="num">{coins}</span>
              <span role="cell" class="num c-vc">{vc}</span>
              <span role="cell"><span class={`gk-badge ${st}`}>{label[st]}</span></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <p class="rms-cue" data-cue aria-hidden="true"></p>
</div>

<script>
  import { autoplay, reduceMotion, type Step } from './autoplay';

  // Counter sign-ups that walk through door 2 and later open the app (mock data).
  const NEW = [
    { name: 'Ika Putri', tel: '+62 838-9876-5432', coins: 1000 },
    { name: 'Rahmat Hidayat', tel: '+62 852-4410-7783', coins: 1100 },
  ];

  document.querySelectorAll<HTMLElement>('[data-rms]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[data-rows]')!;
    const cue = root.querySelector<HTMLElement>('[data-cue]')!;
    let row: HTMLElement | null = null;

    const say = (t: string) => {
      cue.textContent = t;
      cue.classList.remove('is-on'); void cue.offsetWidth;
      cue.classList.add('is-on');
    };
    const quiet = () => cue.classList.remove('is-on');
    const add = (p: (typeof NEW)[number]) => {
      row = document.createElement('div');
      row.className = 'rms-tr is-new';
      row.setAttribute('role', 'row');
      row.innerHTML = `<span role="cell" class="rms-who"><b></b><small></small></span><span role="cell" class="rms-via">SPG Portal<small>oleh Siska Amalia</small></span><span role="cell" class="num" data-coins>0</span><span role="cell" class="num c-vc">0</span><span role="cell"><span class="gk-badge new" data-st>BELUM AKTIVASI</span></span>`;
      row.querySelector('b')!.textContent = p.name;
      row.querySelector('small')!.textContent = p.tel;
      list.prepend(row);
      while (list.children.length > 6) list.lastElementChild!.remove();
      requestAnimationFrame(() => row?.classList.add('in'));
    };
    const coins = (to: number) => {
      const el = row?.querySelector<HTMLElement>('[data-coins]');
      if (!el) return;
      const t0 = performance.now();
      el.classList.add('tick');
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 700);
        el.textContent = Math.round(to * k).toLocaleString('en-US');
        if (k < 1) requestAnimationFrame(step); else el.classList.remove('tick');
      };
      requestAnimationFrame(step);
    };
    const activate = () => {
      const b = row?.querySelector<HTMLElement>('[data-st]');
      if (!b) return;
      b.className = 'gk-badge on pop';
      b.textContent = 'AKTIF';
    };

    if (reduceMotion()) {
      add(NEW[0]); coins(NEW[0].coins); activate();
      return;
    }
    const steps: Step[] = [];
    for (const p of NEW) {
      steps.push([() => { add(p); say(`${p.name} signs up at the counter, with clerk Siska`); }, 2600]);
      steps.push([() => { coins(p.coins); say('The clerk adds the coins from her store visit'); }, 2600]);
      steps.push([() => { say(`${p.name.split(' ')[0]} signs in to the app with the same number`); row?.classList.add('ping'); }, 1300]);
      steps.push([() => { activate(); }, 2600]);
      steps.push([() => { quiet(); row?.classList.remove('is-new', 'ping'); }, 1600]);
    }
    autoplay(root, steps, { startDelay: 900, onStop: quiet });
  });
</script>

<style>
  .rms { position: relative; display: grid; grid-template-columns: 200px minmax(0, 1fr); background: var(--bg); min-height: 520px; }
  .rms-side { display: flex; flex-direction: column; gap: 2px; padding: 16px 10px; background: #fff; border-right: 1px solid var(--line); font-size: 13px; }
  .rms-logo { display: flex; align-items: center; gap: 6px; padding: 0 6px 18px; white-space: nowrap; }
  .rms-logo b { font-size: 15px; font-weight: 800; letter-spacing: -.03em; color: var(--g); }
  .rms-logo i { font-style: normal; color: #f5b800; }
  .rms-logo > span { padding-left: 6px; border-left: 1px solid var(--g); color: var(--g); font-size: 12.5px; }
  .rms-sec { padding: 0 6px 8px; font-size: 10.5px; letter-spacing: .04em; color: #8a8a90; }
  .rms-nav { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 4px; color: #55555c; }
  .rms-nav.on { background: var(--g-tint); color: var(--g); }
  .rms-main { min-width: 0; display: flex; flex-direction: column; }
  .rms-top { display: flex; justify-content: flex-end; align-items: center; height: 48px; padding: 0 18px; background: #fff; box-shadow: 0 1px 6px rgba(0, 0, 0, .05); }
  .rms-user { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; }
  .rms-av { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #e8d7c8; color: #6b4b2e; font-weight: 600; font-size: 12px; }
  .rms-body { padding: 18px 18px 22px; }
  .rms-h { font-size: 19px; font-weight: 500; }
  .rms-bar { display: flex; justify-content: space-between; gap: 12px; margin: 14px 0 10px; padding: 12px; border-radius: 4px; background: #fff; }
  .rms-search { flex: 0 1 290px; min-height: 36px; font-size: 13px; }
  .rms-filter { display: inline-flex; align-items: center; gap: 8px; padding: 0 14px; border-radius: 4px; box-shadow: inset 0 0 0 1px var(--line-2); font-size: 13px; }
  .rms-table { font-size: 13px; }
  .rms-tr { display: grid; grid-template-columns: 1.35fr 1.2fr .95fr .85fr 1fr; gap: 12px; align-items: center; min-height: 54px; margin-bottom: 6px; padding: 8px 14px; border-radius: 3px; background: #fff; }
  .rms-tr.th { min-height: 40px; margin-bottom: 6px; background: transparent; font-weight: 500; font-size: 13px; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .rms-tr > span:last-child { padding-left: 14px; }
  .rms-who, .rms-via { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .rms-who b { font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  small { font-size: 11px; color: #9a9aa0; white-space: nowrap; }
  .rms-rows :global(.rms-tr) { display: grid; grid-template-columns: 1.35fr 1.2fr .95fr .85fr 1fr; gap: 12px; align-items: center; min-height: 54px; margin-bottom: 6px; padding: 8px 14px; border-radius: 3px; background: #fff; transition: background-color 1.2s, box-shadow .4s; }
  .rms-rows :global(.rms-who), .rms-rows :global(.rms-via) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .rms-rows :global(.rms-who b) { font-weight: 400; }
  .rms-rows :global(small) { font-size: 11px; color: #9a9aa0; white-space: nowrap; }
  .rms-rows :global(.num) { text-align: right; font-variant-numeric: tabular-nums; }
  .rms-rows :global(.rms-tr > span:last-child) { padding-left: 14px; }
  .rms-rows :global(.rms-tr.is-new) { background: #f2fbf6; box-shadow: inset 3px 0 0 var(--g); }
  .rms-rows :global(.rms-tr.is-new:not(.in)) { opacity: 0; transform: translateY(-12px); }
  .rms-rows :global(.rms-tr.in) { transition: opacity .4s, transform .45s var(--ease), background-color 1.2s, box-shadow .4s; }
  .rms-rows :global(.rms-tr.ping) { box-shadow: inset 3px 0 0 var(--g), 0 0 0 2px rgba(21, 148, 103, .35); }
  .rms-rows :global([data-coins].tick) { color: var(--g); font-weight: 600; }
  .rms-rows :global(.gk-badge.pop) { animation: rms-pop .45s cubic-bezier(.2, .9, .3, 1.4); }
  @keyframes rms-pop { from { transform: scale(.6); } }

  .rms-cue { position: absolute; right: 18px; bottom: 16px; z-index: 6; max-width: calc(100% - 36px); margin: 0; padding: 8px 12px 8px 30px; border-radius: 999px; background: #151517; color: #fff; font-size: 12.5px; font-weight: 500; line-height: 1.35; box-shadow: 0 8px 22px rgba(0, 0, 0, .2); opacity: 0; transform: translateY(6px); transition: opacity .25s, transform .3s var(--ease); pointer-events: none; }
  .rms-cue::before { content: ''; position: absolute; left: 12px; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: var(--g); box-shadow: 0 0 0 3px rgba(21, 148, 103, .35); }
  .rms-cue.is-on { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .rms { grid-template-columns: minmax(0, 1fr); }
    .rms-side { display: none; }
  }
  @media (max-width: 620px) {
    .rms-top { display: none; }
    .rms-body { padding: 14px 10px 64px; }
    .rms-bar { padding: 8px; }
    .rms-filter { display: none; }
    .rms-tr, .rms-rows :global(.rms-tr) { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) 104px; gap: 8px; padding: 8px 10px; font-size: 12px; }
    .rms-tr > span:last-child, .rms-rows :global(.rms-tr > span:last-child) { text-align: right; }
    .rms-tr > .num, .rms-rows :global(.rms-tr > .num) { display: none; }
    .rms-tr > span:last-child, .rms-rows :global(.rms-tr > span:last-child) { padding-left: 0; }
    .rms-cue { left: 10px; right: 10px; bottom: 12px; border-radius: 10px; }
  }
</style>
